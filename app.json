{
  "expo": {
    "name": "MoveUp Connect",
    "slug": "moveup-connect",
    "description": "Aplicação móvel de acompanhamento de treino do projeto MoveUp Connect.",
    "version": "0.1.0",
    "scheme": "moveup-connect",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "userInterfaceStyle": "light",
    "web": {
      "output": "static",
      "lang": "pt-PT"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
